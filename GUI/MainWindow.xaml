<Window x:Class="Fwoign.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:local="clr-namespace:Fwoign"
        Title="Fwoign V1.0"
        Icon="app.ico"
        Stylus.IsFlicksEnabled="False"
        Width="1120" Height="980"
        MinWidth="900" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei"
        Background="{DynamicResource RegionBrush}">

    <Window.Resources>
        <!-- 标签行右侧的“开始”按钮：绿色 -->
        <Style x:Key="ActionStartStyle" TargetType="Button">
            <Setter Property="Background" Value="#1B9C4B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="5" Background="{TemplateBinding Background}"
                                Padding="16,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#23B85A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14763A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#C9CDD4"/>
                                <Setter Property="Foreground" Value="#F4F5F7"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 标签行右侧的“停止”按钮：红色 -->
        <Style x:Key="ActionStopStyle" TargetType="Button">
            <Setter Property="Background" Value="#D9463B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="82"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="5" Background="{TemplateBinding Background}"
                                Padding="16,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E45A4F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B0332A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#C9CDD4"/>
                                <Setter Property="Foreground" Value="#F4F5F7"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <!-- 默认：备份还原区与日志区取最小高度，剩余全部给客户端列表。
                 高度由代码按上次用户拖动结果恢复（settings.ini 的 TabsHeight / LogHeight） -->
            <RowDefinition x:Name="RowTabs" Height="290" MinHeight="290"/>
            <RowDefinition Height="5"/>
            <RowDefinition x:Name="RowClients" Height="*" MinHeight="150"/>
            <RowDefinition Height="5"/>
            <RowDefinition x:Name="RowLog" Height="130" MinHeight="130"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 网络状态 -->
        <Border Grid.Row="0" Padding="10,8" CornerRadius="6"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,8">
            <StackPanel>
                <!-- 第一行：网卡 + 当前 IP -->
                <WrapPanel VerticalAlignment="Center" Margin="0,0,0,10">
                    <TextBlock Text="网卡" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="CbAdapter" Width="330" VerticalAlignment="Center"
                              SelectionChanged="CbAdapter_SelectionChanged"/>
                    <Button Content="刷新" Margin="12,0,0,0" Padding="14,0"
                            Click="BtnRefreshNet_Click" VerticalAlignment="Center"/>
                    <TextBlock Text="当前 IP" VerticalAlignment="Center" Margin="18,0,8,0"/>
                    <Border VerticalAlignment="Center" CornerRadius="4" Padding="12,4"
                            Background="#FDECEA" BorderBrush="#F0B3AE" BorderThickness="1">
                        <TextBlock x:Name="TxtIp" Text="—" MinWidth="104" TextAlignment="Center"
                                   FontSize="15" FontWeight="Bold" Foreground="#C62828"/>
                    </Border>
                </WrapPanel>

                <!-- 第二行：网络环境 -->
                <WrapPanel VerticalAlignment="Center" Margin="0,0,0,10">
                    <TextBlock Text="网络环境" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <RadioButton x:Name="RbDhcpFull" Content="纯交换机（本机提供 DHCP）" IsChecked="True"
                                 GroupName="netmode" VerticalAlignment="Center" Margin="0,0,20,0"
                                 Checked="NetMode_Checked"/>
                    <RadioButton x:Name="RbDhcpProxy" Content="有路由器（本机只负责引导）"
                                 GroupName="netmode" VerticalAlignment="Center"
                                 Checked="NetMode_Checked"/>
                </WrapPanel>

                <!-- 第三行：设置 IP（仅纯交换机模式可用） -->
                <WrapPanel x:Name="PanelSetIp" VerticalAlignment="Center">
                    <TextBlock Text="设置 IP" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtMyIp" Width="130" VerticalAlignment="Center"/>
                    <Button x:Name="BtnSetIp" Content="一键设置 IP" Margin="14,0,0,0" Padding="12,0"
                            VerticalAlignment="Center" Click="BtnSetIp_Click"/>
                    <Button x:Name="BtnRestoreIp" Content="还原 IP" Margin="8,0,0,0" Padding="12,0"
                            VerticalAlignment="Center" Click="BtnRestoreIp_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="以当前配置重新记录初始 IP" Click="BtnResetIpBackup_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- 忙等指示：改 IP 需要几秒，给个转圈 -->
                    <Grid x:Name="SpinIp" Width="20" Height="20" Margin="12,0,0,0"
                          VerticalAlignment="Center" Visibility="Collapsed">
                        <Path Data="M 10,2.2 A 7.8,7.8 0 1 1 2.2,10"
                              Stroke="#1B4FD8" StrokeThickness="2.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="SpinRotate" Angle="0"/>
                            </Path.RenderTransform>
                        </Path>
                    </Grid>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 公共选项区（还原/备份共用） -->
        <Border Grid.Row="1" Padding="10,8" CornerRadius="6"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,8">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="引导方式" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="CbBootTarget" Width="196" VerticalAlignment="Center" Margin="0,0,18,0">
                    <ComboBoxItem Content="自动（BIOS + UEFI）"/>
                    <ComboBoxItem Content="传统 BIOS"/>
                    <ComboBoxItem Content="仅 UEFI"/>
                </ComboBox>
                <TextBlock Text="完成后" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <RadioButton x:Name="RbDoneRestart" Content="重启客户端" GroupName="doneaction"
                             IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0"
                             ToolTip="客户机任务完成后自动重启（FOS 的默认行为）"/>
                <RadioButton x:Name="RbDoneShutdown" Content="关闭客户端" GroupName="doneaction"
                             VerticalAlignment="Center"
                             ToolTip="客户机任务完成后自动关机（给 FOS 传 shutdown=1）"/>

            </WrapPanel>
        </Border>

        <!-- 主功能区：标签标题与“开始/停止”在同一行 -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <TabControl x:Name="MainTab" SelectionChanged="MainTab_SelectionChanged">
                <TabItem Header="整盘还原" FontSize="15" FontWeight="Bold" Padding="12,9">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 第一行：镜像目录 + 三个按钮靠最右 -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
                            <TextBlock Text="镜像目录：" VerticalAlignment="Center" FontSize="12" Margin="0,0,2,0"/>
                            <Button DockPanel.Dock="Right" Content="打开目录" Margin="6,0,0,0" Padding="10,0"
                                    Height="26" FontSize="12" Click="BtnOpenRestoreFolder_Click"
                                    ToolTip="在资源管理器中打开当前镜像目录"/>
                            <Button DockPanel.Dock="Right" Content="刷新" Margin="6,0,0,0" Padding="10,0"
                                    Height="26" FontSize="12" Click="BtnRefreshRestore_Click"
                                    ToolTip="重新扫描当前镜像目录，显示最新镜像"/>
                            <Button DockPanel.Dock="Right" Content="浏览" Margin="6,0,0,0" Padding="10,0"
                                    Height="26" FontSize="12" Click="BtnBrowseRestore_Click"
                                    ToolTip="选择镜像所在目录"/>
                            <TextBox x:Name="TxtRestoreFolder" Height="26" FontSize="12" VerticalAlignment="Center"
                                     ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </DockPanel>

                        <!-- 下方：左＝镜像列表，右＝还原设置 -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="330"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*" MinWidth="300"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" BorderBrush="#E1E5EB" BorderThickness="1"
                                    CornerRadius="4" Background="White">
                                <ListBox x:Name="ListRestoreImage" FontFamily="Consolas" FontSize="12"
                                         BorderThickness="0" Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         Stylus.IsFlicksEnabled="False"
                                         local:DragScroll.Enabled="True"
                                         SelectionChanged="ListRestoreImage_SelectionChanged"/>
                            </Border>

                            <Border Grid.Column="1" Background="#E8ECF2" Margin="0,2"/>

                            <ScrollViewer Grid.Column="2" Margin="14,0,0,0" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="还原设置" FontSize="13" FontWeight="Bold"
                                           Foreground="#3A4149" Margin="0,0,0,10"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="刻台数" VerticalAlignment="Center" Width="58" FontSize="12"/>
                                    <hc:NumericUpDown x:Name="NumCount" Value="1" Minimum="1" Maximum="252"
                                                      Width="110" Height="26" FontSize="12"/>
                                    <Button x:Name="BtnResetCount" Margin="8,0,0,0"
                                            Width="32" Height="26" Padding="0"
                                            Click="BtnResetCount_Click"
                                            ToolTip="把刻台数恢复为 1 台（单播还原）">
                                        <!-- 自绘：两个箭头首尾相接的循环图标（扇形弧 120°，箭头加大、间距加大） -->
                                        <Viewbox Width="21" Height="21" HorizontalAlignment="Center"
                                                 VerticalAlignment="Center">
                                            <Canvas Width="16" Height="16">
                                                <Path Stroke="#3A4149" StrokeThickness="1.9"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Data="M 3.50,5.40 A 5,5 0 0 1 12.50,5.40"/>
                                                <Path Stroke="#3A4149" StrokeThickness="1.9"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Data="M 12.50,10.60 A 5,5 0 0 1 3.50,10.60"/>
                                                <Path Fill="#3A4149" Data="M 13.90,7.82 L 10.48,6.10 L 14.12,4.00 Z"/>
                                                <Path Fill="#3A4149" Data="M 2.10,8.18 L 5.52,9.90 L 1.88,12.00 Z"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Button>
                                </StackPanel>

                                <TextBlock Text="已选镜像" FontSize="12" Foreground="#6B7280" Margin="0,4,0,4"/>
                                <Border Padding="10,8" CornerRadius="6"
                                        Background="#EAF3FF"
                                        BorderBrush="#8FB8E8" BorderThickness="1">
                                    <TextBlock x:Name="TxtRestoreHint" TextWrapping="Wrap" FontSize="12"
                                               LineHeight="20"
                                               Foreground="#12467F" FontWeight="SemiBold"
                                               Text="请在左侧列表中选择要还原的镜像。"/>
                                </Border>
                            </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="整盘备份" FontSize="15" FontWeight="Bold" Padding="12,9">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 第一行：镜像目录 + 三个按钮靠最右 -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
                            <TextBlock Text="镜像目录：" VerticalAlignment="Center" FontSize="12" Margin="0,0,2,0"/>
                            <Button DockPanel.Dock="Right" Content="打开目录" Margin="6,0,0,0" Padding="10,0"
                                    Height="26" FontSize="12" Click="BtnOpenBackupFolder_Click"
                                    ToolTip="在资源管理器中打开当前镜像目录"/>
                            <Button DockPanel.Dock="Right" Content="刷新" Margin="6,0,0,0" Padding="10,0"
                                    Height="26" FontSize="12" Click="BtnRefreshBackup_Click"
                                    ToolTip="重新扫描当前镜像目录，显示最新镜像"/>
                            <Button DockPanel.Dock="Right" Content="浏览" Margin="6,0,0,0" Padding="10,0"
                                    Height="26" FontSize="12" Click="BtnBrowseBackup_Click"
                                    ToolTip="选择镜像保存目录"/>
                            <TextBox x:Name="TxtBackupPath" Height="26" FontSize="12" VerticalAlignment="Center"
                                     ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                     TextChanged="BackupPath_TextChanged"/>
                        </DockPanel>

                        <!-- 下方：左＝已有镜像，右＝备份设置 -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="330"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*" MinWidth="300"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" BorderBrush="#E1E5EB" BorderThickness="1"
                                    CornerRadius="4" Background="White">
                                <ListBox x:Name="ListBackupImage" FontFamily="Consolas" FontSize="12"
                                         BorderThickness="0" Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         Stylus.IsFlicksEnabled="False"
                                         local:DragScroll.Enabled="True"
                                         SelectionChanged="ListBackupImage_SelectionChanged"/>
                            </Border>

                            <Border Grid.Column="1" Background="#E8ECF2" Margin="0,2"/>

                            <ScrollViewer Grid.Column="2" Margin="14,0,0,0" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="备份设置" FontSize="13" FontWeight="Bold"
                                           Foreground="#3A4149" Margin="0,0,0,10"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="备份名称" VerticalAlignment="Center" Width="62" FontSize="12"/>
                                    <TextBox x:Name="TxtBackupName" Width="260" Height="26" FontSize="12"
                                             VerticalAlignment="Center"
                                             TextChanged="BackupTarget_TextChanged"/>
                                </StackPanel>

                                <TextBlock Text="点左侧镜像可套用名称；备份固定单机，一次一台" FontSize="11.5"
                                           Foreground="#6B7280" Margin="0,0,0,8" TextWrapping="Wrap"/>

                                <Border x:Name="BdBackupHint" Padding="10,8" CornerRadius="6"
                                        Background="#EAF3FF" BorderBrush="#8FB8E8" BorderThickness="1">
                                    <TextBlock x:Name="TxtBackupHint" TextWrapping="Wrap" FontSize="12"
                                               LineHeight="20"
                                               Foreground="#12467F" FontWeight="SemiBold"
                                               Text="请先选择备份路径。"/>
                                </Border>
                            </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- 与标签标题同一行、靠最右：开始 / 停止 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,4,8,0">
                <Button x:Name="BtnStart" Content="开始还原" Style="{StaticResource ActionStartStyle}"
                        Click="BtnStart_Click"/>
                <Button x:Name="BtnForceStart" Content="直接开始" Margin="8,0,0,0" IsEnabled="False"
                        Height="28" MinWidth="96" FontSize="13" FontWeight="Bold"
                        Foreground="White" Background="#E6A23C" Cursor="Hand"
                        Click="BtnForceStart_Click"
                        ToolTip="多播时：不等剩余客户端，按已到齐的台数立即开始发送"/>
                <Button x:Name="BtnStop" Content="停止" Style="{StaticResource ActionStopStyle}"
                        Margin="8,0,0,0" IsEnabled="False" Click="BtnStop_Click"/>
            </StackPanel>
        </Grid>

        <!-- 拖动条：功能区 / 客户端 -->
        <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                      Background="#E6EAF0" ShowsPreview="False" Cursor="SizeNS"/>

        <!-- 客户端（高度可拖） -->
        <DockPanel Grid.Row="4">
                <TextBlock x:Name="TxtClientTitle" DockPanel.Dock="Top" Text="客户端"
                           FontSize="15" FontWeight="Bold" Margin="1,0,0,4"/>
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="4" Background="White">
                    <ListView x:Name="ListClients" FontSize="12" BorderThickness="0"
                              SizeChanged="ListClients_SizeChanged"
                              Background="Transparent"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              Stylus.IsFlicksEnabled="False"
                              local:DragScroll.Enabled="True">
                        <ListView.Resources>
                            <!-- 表头：去掉默认框线与外框，高度只比字号高一点点 -->
                            <Style x:Key="ColHdrCenter" TargetType="{x:Type GridViewColumnHeader}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="2,0"/>
                                <Setter Property="Height" Value="21"/>
                                <Setter Property="FontSize" Value="11.5"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#57606A"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
                                            <Border Background="Transparent" BorderThickness="0">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="{TemplateBinding Padding}"
                                                                  RecognizesAccessKey="True"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <Style x:Key="ColHdrLeft" TargetType="{x:Type GridViewColumnHeader}"
                                   BasedOn="{StaticResource ColHdrCenter}">
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                <Setter Property="Padding" Value="6,0,0,0"/>
                            </Style>
                        </ListView.Resources>

                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinHeight" Value="22"/>
                                <Setter Property="Padding" Value="2,0"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <!-- 列宽按现场反馈重排：IP/MAC/状态收紧，把宽度让给「已拷贝/总量」和「结果」；
                                     除「结果」外，表头与单元格一律居中 -->
                                <GridViewColumn Header="IP" Width="92" HeaderContainerStyle="{StaticResource ColHdrCenter}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Ip}" TextAlignment="Center"/></DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="MAC" Width="116" HeaderContainerStyle="{StaticResource ColHdrCenter}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Mac}" TextAlignment="Center"/></DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="状态" Width="60" HeaderContainerStyle="{StaticResource ColHdrCenter}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding State}" Foreground="{Binding StateBrush}"
                                                       FontWeight="Bold" TextAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="进度" Width="120" HeaderContainerStyle="{StaticResource ColHdrCenter}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <!-- 进度条用自绘模板（HandyControl 的默认模板会自带百分比文字），
                                                 百分比只在条内居中显示一层 -->
                                            <Grid Width="112" Height="16" HorizontalAlignment="Center">
                                                <ProgressBar Maximum="100" Value="{Binding PercentValue}"
                                                             Background="#E6EAF0" Foreground="#5B9BD5"
                                                             VerticalAlignment="Center" Height="14">
                                                    <ProgressBar.Template>
                                                        <ControlTemplate TargetType="ProgressBar">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    CornerRadius="3" ClipToBounds="True">
                                                                <Grid>
                                                                    <Border x:Name="PART_Track"/>
                                                                    <Border x:Name="PART_Indicator"
                                                                            HorizontalAlignment="Left"
                                                                            Background="{TemplateBinding Foreground}"
                                                                            CornerRadius="3"/>
                                                                </Grid>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </ProgressBar.Template>
                                                </ProgressBar>
                                                <TextBlock Text="{Binding PercentText}" FontSize="10.5"
                                                           Foreground="#1F2D3D" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="已拷贝/总量" Width="152" HeaderContainerStyle="{StaticResource ColHdrCenter}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ProgressText}" TextAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding ProgressText}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="用时" Width="62" HeaderContainerStyle="{StaticResource ColHdrCenter}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Elapsed}" TextAlignment="Center"/></DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="剩余" Width="62" HeaderContainerStyle="{StaticResource ColHdrCenter}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Remaining}" TextAlignment="Center"/></DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="结果" Width="380" HeaderContainerStyle="{StaticResource ColHdrLeft}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Result}" Foreground="{Binding ResultBrush}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                       TextAlignment="Left" Margin="6,0,0,0"
                                                       ToolTip="{Binding Result}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>
            </DockPanel>

        <!-- 拖动条：客户端 / 日志 -->
        <GridSplitter Grid.Row="5" Height="5" HorizontalAlignment="Stretch"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                      Background="#E6EAF0" ShowsPreview="False" Cursor="SizeNS"/>

        <!-- 运行日志（高度可拖） -->
            <DockPanel Grid.Row="6">
                <Grid DockPanel.Dock="Top" Margin="1,0,0,4">
                    <TextBlock Text="运行日志" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button x:Name="BtnClearLog" Content="清除" HorizontalAlignment="Right"
                            Padding="12,0" Height="24" FontSize="12" Click="BtnClearLog_Click"
                            ToolTip="只清空这里的显示，不删除日志文件"/>
                </Grid>
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="4" Background="White">
                    <RichTextBox x:Name="RtbLog" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 BorderThickness="0" Background="Transparent" Padding="4,2,2,2"
                                 Stylus.IsFlicksEnabled="False"
                                 local:DragScroll.Enabled="True">
                        <FlowDocument PagePadding="0" PageWidth="3000"
                                      FontFamily="Consolas" FontSize="11.5"/>
                    </RichTextBox>
                </Border>
            </DockPanel>

        <!-- 状态栏 -->
        <Border Grid.Row="7" Padding="10,6" CornerRadius="4" Background="{DynamicResource RegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <TextBlock x:Name="TxtStatus" Text="就绪" FontSize="12"
                       Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</Window>
