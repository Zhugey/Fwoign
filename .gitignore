# ============================================================
#  Fwoign 仓库忽略规则
#  原则：仓库只放源码与文档；运行依赖、构建产物、本机数据一律不入库。
# ============================================================

# 构建输出
src/bin/
src/obj/

# 运行依赖与本机数据（使用者自备，见 docs\运行文件说明.md）
runtime-local/

# 文档转换中间文件（PDF 生成时的 HTML）
docs/*.html

# 打包产物
dist/
*.zip
*.7z

# 备份与临时恢复目录
_backup/
_recover/

# 本机杂项
.vs/
*.user
*.suo
Thumbs.db
desktop.ini
