<Window x:Class="Fwoign.NoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提示"
        Width="520" SizeToContent="Height" MaxHeight="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Microsoft YaHei"
        Background="{DynamicResource RegionBrush}">
    <Border Margin="16" Padding="20,18,20,16" CornerRadius="6"
            Background="White" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock x:Name="TxtIcon" Text="&#xE946;" FontFamily="Segoe MDL2 Assets"
                           FontSize="19" Foreground="#D19A00" VerticalAlignment="Top" Margin="0,1,10,0"/>
                <TextBlock x:Name="TxtTitle" FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center" Text="提示"/>
            </StackPanel>

            <TextBlock x:Name="TxtMessage" FontSize="12.5" Foreground="#3A4149"
                       TextWrapping="Wrap" LineHeight="21" Margin="29,0,0,0"/>

            <Button x:Name="BtnOk" Content="知道了" Width="96" Height="30" FontSize="12"
                    HorizontalAlignment="Right" Margin="0,16,0,0"
                    IsDefault="True" IsCancel="True" Click="BtnOk_Click"/>
        </StackPanel>
    </Border>
</Window>
