<Window x:Class="Fwoign.MissingRuntimeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="缺少运行文件"
        Width="720" Height="540" MinWidth="640" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        FontFamily="Microsoft YaHei"
        Background="{DynamicResource RegionBrush}">
    <Border Margin="16" Padding="20,18,20,14" CornerRadius="6"
            Background="White" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                           Foreground="#D19A00" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="缺少运行所需的文件" FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Grid.Row="1" FontSize="12.5" Foreground="#57606A" TextWrapping="Wrap"
                       LineHeight="20" Margin="0,0,0,10"
                       Text="下列文件不在程序目录中。程序可以先打开，但点「开始」后相关服务会启动失败。请按下表的「应放位置」放入文件后重启程序。"/>

            <Border Grid.Row="2" BorderBrush="#E1E5EB" BorderThickness="1" CornerRadius="4"
                    Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 表头：与下方各行共用同一套列宽，固定在顶部不随列表滚动 -->
                    <Border Grid.Row="0" Background="#F6F8FA" BorderBrush="#E1E5EB"
                            BorderThickness="0,0,0,1" Padding="10,7,10,7">
                        <Grid x:Name="HeaderGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="84"/>
                                <ColumnDefinition Width="238"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="缺失的文件" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="#57606A"/>
                            <TextBlock Grid.Column="1" Text="应放位置" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="#57606A"/>
                            <TextBlock Grid.Column="2" Text="获取方式（可点击）" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="#57606A"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.PanningMode="None" IsManipulationEnabled="False">
                        <StackPanel x:Name="ListMissing" Margin="10,8,10,8"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                <TextBlock x:Name="TxtFoot" FontSize="11.5" Foreground="#8C959F"
                           TextWrapping="Wrap" LineHeight="18"
                           Text="haneWIN NFS Server 是商业软件，需自行购买授权；本项目不分发，也不提供授权信息。"/>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：说明文档位置（可直接选中复制） -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="说明文档位置：" FontSize="11" Foreground="#8C959F"/>
                        <TextBox x:Name="TxtDocPath" IsReadOnly="True" BorderThickness="0"
                                 Background="Transparent" FontSize="11" Foreground="#57606A"
                                 TextWrapping="Wrap" Padding="0" Margin="0,2,0,0"
                                 ToolTip="选中后按 Ctrl+C 可复制路径"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button x:Name="BtnDoc" Content="查看说明文档（PDF）" Padding="12,0" Height="30" FontSize="12"
                                Margin="0,0,8,0" Click="BtnDoc_Click"
                                ToolTip="用系统默认程序打开 docs\运行文件说明.pdf"/>
                        <Button Content="我知道了" Width="96" Height="30" FontSize="12"
                                IsDefault="True" IsCancel="True" Click="BtnOk_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

        </Grid>
    </Border>
</Window>
